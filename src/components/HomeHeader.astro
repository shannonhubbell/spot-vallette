---
import ShipWheel from "../assets/img/ship-wheel.svg";
---

<header id="home-header">
    <img src={ShipWheel.src} class="ship-wheel" alt="Ship's Wheel" />
    <div class="layout" data-aos="fade-up" data-aos-duration="2000">
        <h1>Spot Vallette</h1>
        <h2>New Orleans Eats</h2>
    </div>
    <div class="info">
        <a href="#halloween" class="cta shiver">
            Costume Contest!<br />This Halloween!
        </a>
        <address>
            1926 Hubbell Road<br />
            Oakland, CA 94607
        </address>
        <dl>
            <dt>Monday - Thursday</dt>
            <dd>
                <time datetime="09:00">9:00 AM</time> – <time datetime="19:00"
                    >7:00 PM</time
                >
            </dd>
            <br />
            <dt>Friday - Saturday</dt>
            <dd>
                <time datetime="11:00">11:00 AM</time> – <time datetime="21:00"
                    >9:00 PM</time
                >
            </dd>
        </dl>
    </div>
</header>

<style>
    @keyframes spin {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(360deg);
        }
    }
    #home-header {
        background-image: url(../assets/img/bkgd-ferry.webp);
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
        text-align: center;
        position: relative;
        padding: 5rem 0;
        overflow: hidden;
        box-shadow: 5px -6px 44px -15px #000000;
        .ship-wheel {
            position: absolute;
            top: -55%;
            right: -25%;
            width: 150%;
            height: auto;
            transform: rotate(70deg);
            animation: spin 60s linear infinite;
            transform-origin: center;
            opacity: 0.15;
        }
    }
    h1 {
        font-size: 8em;
        margin: 0;
        color: #fff;
        line-height: 140%;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }
    h2 {
        font-family: var(--font-body);
        text-transform: uppercase;
        margin: 0;
        font-size: 3rem;
        line-height: 100%;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        transform: rotate(-2deg);
    }

    @media (max-width: 768px) {
        h1 {
            font-size: 4em;
        }
        h2 {
            font-size: 2rem;
        }
    }

    @keyframes shiver-animation {
        0% {
            transform: translate(0, 0) rotate(9deg);
        }
        20% {
            transform: translate(-1px, 1px) rotate(9.5deg);
        }
        40% {
            transform: translate(-1px, -1px) rotate(8.5deg);
        }
        60% {
            transform: translate(1px, 1px) rotate(9.5deg);
        }
        80% {
            transform: translate(1px, -1px) rotate(8.5deg);
        }
        100% {
            transform: translate(0, 0) rotate(9deg);
        }
    }

    .shiver:hover {
        animation: shiver-animation 0.15s infinite linear;
        transform: scale(2);
    }

    .info {
        background: var(--color-dark);
        color: #fff;
        font-weight: bold;
        display: inline-block;
        padding: 1.5rem;
        min-width: 300px;
        margin: 3rem 0 0 0;
        position: relative;
        box-shadow: 5px -6px 44px -15px #000000;
        border-radius: 10px;
        transform: rotate(5deg);
        a.cta {
            position: absolute;
            background: #000;
            color: orange;
            top: -2rem;
            right: -2rem;
            border: 1px solid red;
            text-decoration: none;
            padding: 0.5rem;
            transform: rotate(9deg);
            -webkit-box-shadow: 5px -6px 44px -15px #000000;
            box-shadow: 5px -6px 44px -15px #000000;
            @media (max-width: 768px) {
                right: 0;
            }
        }
        address {
            font-style: normal;
            font-size: 1.5rem;
            color: #e1f4cb;
            font-weight: 200;
        }
        dl {
            border-top: 1px solid #fff;
            padding: 1rem 0 0 0;
            display: block;
            margin: 1em 0 0;
            font-weight: 200;

            dt {
                padding-top: 0 0 0 0;
                display: block;
            }
            dd {
                margin: 0;
                padding: 0;
                font-weight: normal;
            }
        }
    }
</style>
